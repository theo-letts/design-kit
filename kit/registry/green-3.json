  "css": {
    ":root": {
      "--border-width": "1px",
      "--shadow-card": "0 1px 1px 0px oklch(0.18 0.0055 45 / 0.040), 0 2px 2px 0px oklch(0.18 0.0055 45 / 0.020)",
      "--shadow-button": "var(--outline-drop) var(--outline-drop) 0 0 var(--outline-ink)",
      "--tracking-heading": "-0.02em",
      "--weight-heading": "400",
      "--type-tracking": "0em",
      "--surface-blur": "0px",
      "--surface-saturate": "1",
      "--tilt-range": "0deg",
      "--motion-duration": "190ms",
      "--motion-ease": "cubic-bezier(0.4, 0, 0.2, 1)",
      "--texture-image": "none",
      "--texture-size": "auto",
      "--texture-position": "0 0",
      "--texture-blend": "normal",
      "--card-texture-image": "none",
      "--card-texture-size": "auto",
      "--card-texture-position": "0 0",
      "--card-texture-blend": "normal",
      "--backdrop-image": "none",
      "--backdrop-filter": "url(#dk-duotone)",
      "--backdrop-opacity": "0.32",
      "--outline-lit": "oklch(1 0 0 / 0.75)",
      "--outline-shade": "oklch(0 0 0 / 0.05)",
      "--outline-top": "oklch(0.7556 0.0095 45 / 0.95)",
      "--outline-bottom": "oklch(0.7556 0.0095 45 / 0.12)",
      "--outline-arm": "14px",
      "--outline-ink": "oklch(0.6511 0.0678 146.93)",
      "--outline-ink-destructive": "oklch(0.7427 0.1238 32.23)",
      "--outline-drop": "calc(var(--border-width, 1px) * 3)",
      "--ring-soft": "oklch(0.5309 0.1112 146.93 / 0.22)",
      "--outline-mark": "oklch(0.6114 0.0119 45)",
      "--elevation-0": "none",
      "--elevation-1": "0 1px 1px 0px oklch(0.18 0.0055 45 / 0.040), 0 2px 2px 0px oklch(0.18 0.0055 45 / 0.020)",
      "--elevation-2": "0 1px 2px 0px oklch(0.18 0.0055 45 / 0.060), 0 2px 4px 0px oklch(0.18 0.0055 45 / 0.030)",
      "--elevation-3": "0 2px 4px 0px oklch(0.18 0.0055 45 / 0.080), 0 4px 9px 0px oklch(0.18 0.0055 45 / 0.040)"
    },
    ".dark": {
      "--shadow-card": "0 1px 1px 0px oklch(0 0.0006 4.5 / 0.040), 0 2px 2px 0px oklch(0 0.0006 4.5 / 0.020)",
      "--outline-lit": "oklch(1 0 0 / 0.11)",
      "--outline-shade": "oklch(0 0 0 / 0.35)",
      "--outline-top": "oklch(0.4978 0.0082 45 / 0.85)",
      "--outline-bottom": "oklch(0.4978 0.0082 45 / 0.08)",
      "--outline-ink": "oklch(0.4965 0.0644 146.93)",
      "--outline-ink-destructive": "oklch(0.5222 0.1176 32.23)",
      "--ring-soft": "oklch(0.62 0.1056 146.93 / 0.3)",
      "--outline-mark": "oklch(0.6322 0.0093 45)",
      "--elevation-1": "0 1px 1px 0px oklch(0 0.0006 4.5 / 0.040), 0 2px 2px 0px oklch(0 0.0006 4.5 / 0.020)",
      "--elevation-2": "0 1px 2px 0px oklch(0 0.0006 4.5 / 0.060), 0 2px 4px 0px oklch(0 0.0006 4.5 / 0.030)",
      "--elevation-3": "0 2px 4px 0px oklch(0 0.0006 4.5 / 0.080), 0 4px 9px 0px oklch(0 0.0006 4.5 / 0.040)"
    },
    ":root, *": {
      "text-transform": "lowercase",
      "font-variant-caps": "normal"
    },
    "input, textarea, code, pre, abbr, [data-case=\"keep\"]": {
      "text-transform": "none",
      "font-variant-caps": "normal"
    },
    "[data-slot=\"card-title\"], h1, h2, h3": {
      "letter-spacing": "var(--tracking-heading)",
      "font-weight": "var(--weight-heading)"
    },
    "[data-slot=\"label\"], [data-slot=\"badge\"], [data-slot=\"eyebrow\"], [data-slot=\"button\"], th": {
      "text-transform": "lowercase",
      "font-variant-caps": "normal"
    },
    "[data-slot=\"card-title\"]": {
      "font-size": "calc(1rem * 1.25)"
    },
    "[data-slot=\"card\"], [data-slot=\"alert\"], [data-slot=\"popover-content\"], [data-slot=\"hover-card-content\"], [data-slot=\"context-menu-content\"], [data-slot=\"alert-dialog-content\"], [data-slot=\"sheet-content\"], [data-slot=\"toast\"], [data-slot=\"calendar\"], [data-slot=\"item-group\"], [data-slot=\"empty\"]": {
      "border-style": "solid",
      "border-width": "var(--border-width)",
      "box-shadow": "var(--shadow-card)"
    },
    "[data-slot=\"input\"], [data-slot=\"textarea\"], [data-slot=\"select\"], [data-slot=\"input-group\"], [data-slot=\"input-otp-slot\"], [data-slot=\"combobox-trigger\"], [data-slot=\"radio-card\"], [data-slot=\"toggle-group\"], [data-slot=\"button\"][data-variant=\"outline\"]": {
      "border-style": "solid",
      "border-width": "var(--border-width)"
    },
    "[data-slot=\"input-group\"] > input, [data-slot=\"input-group\"] > [data-slot=\"input\"], [data-slot=\"input-group\"] > textarea": {
      "border-width": "0",
      "border-radius": "0",
      "box-shadow": "none"
    },
    "[data-slot=\"button\"][data-variant=\"default\"], [data-slot=\"button\"][data-variant=\"secondary\"], [data-slot=\"button\"][data-variant=\"destructive\"]": {
      "box-shadow": "var(--shadow-button)"
    },
    "[data-slot=\"card\"], [data-slot=\"alert\"], [data-slot=\"item-group\"]": {
      "border-color": "var(--outline-ink)",
      "box-shadow": "var(--outline-drop) var(--outline-drop) 0 0 var(--outline-ink)"
    },
    "[data-slot=\"button\"]:not([data-variant=\"ghost\"]):not([data-variant=\"link\"])": {
      "border": "var(--border-width, 1px) solid var(--outline-ink)",
      "box-shadow": "var(--outline-drop) var(--outline-drop) 0 0 var(--outline-ink)"
    },
    "[data-slot=\"button\"]:not([data-variant=\"ghost\"]):not([data-variant=\"link\"]):active": {
      "translate": "var(--outline-drop) var(--outline-drop)",
      "box-shadow": "none"
    },
    "@media (prefers-reduced-motion: no-preference)": {
      "[data-slot=\"button\"]:not([data-variant=\"ghost\"]):not([data-variant=\"link\"])": {
        "transition-property": "all, translate, box-shadow",
        "transition-duration": "var(--motion-duration, 150ms), 80ms, 80ms"
      }
    },
    "[data-variant=\"destructive\"], [data-tone=\"destructive\"]": {
      "--outline-ink": "var(--outline-ink-destructive)"
    },
    "[data-slot=\"button-group\"] > [data-slot=\"button\"]:not([data-variant=\"ghost\"]):not([data-variant=\"link\"])": {
      "box-shadow": "none"
    },
    "[data-slot=\"button-group\"] > [data-slot=\"button\"]:not([data-variant=\"ghost\"]):not([data-variant=\"link\"]):active": {
      "translate": "none"
    },
    "[data-slot=\"input-group\"] > [data-slot=\"button\"]:not([data-variant=\"ghost\"]):not([data-variant=\"link\"])": {
      "box-shadow": "none"
    },
    "[data-slot=\"input-group\"] > [data-slot=\"button\"]:not([data-variant=\"ghost\"]):not([data-variant=\"link\"]):active": {
      "translate": "none"
    },
    "[data-slot=\"button-group\"]": {
      "border-radius": "calc(var(--radius) - 2px)",
      "box-shadow": "var(--outline-drop) var(--outline-drop) 0 0 var(--outline-ink)"
    },
    "@media (pointer: coarse)": {
      "[data-slot=\"button\"], [data-slot=\"toggle\"], [data-slot=\"checkbox\"], [data-slot=\"radio-group-item\"], [data-slot=\"switch\"], [data-slot=\"menu-item\"], [data-slot=\"input-otp-slot\"], [role=\"tab\"]": {
        "position": "relative"
      },
      "[data-slot=\"button\"]::after, [data-slot=\"toggle\"]::after, [data-slot=\"checkbox\"]::after, [data-slot=\"radio-group-item\"]::after, [data-slot=\"switch\"]::after, [data-slot=\"menu-item\"]::after, [data-slot=\"input-otp-slot\"]::after, [role=\"tab\"]::after": {
        "content": "\"\"",
        "position": "absolute",
        "top": "50%",
        "left": "50%",
        "translate": "-50% -50%",
        "min-width": "44px",
        "min-height": "44px",
        "pointer-events": "none"
      }
    },
    "[data-slot=\"tabs-list\"], [data-slot=\"button-group\"], [data-slot=\"toggle-group\"], [data-slot=\"pagination\"]": {
      "max-width": "100%",
      "overflow-x": "auto",
      "scrollbar-width": "none"
    },
    "[data-slot=\"tabs-list\"]::-webkit-scrollbar, [data-slot=\"button-group\"]::-webkit-scrollbar, [data-slot=\"toggle-group\"]::-webkit-scrollbar, [data-slot=\"pagination\"]::-webkit-scrollbar": {
      "display": "none"
    },
    "code, [data-slot=\"kbd\"]": {
      "overflow-wrap": "anywhere"
    },
    "[data-slot=\"table-scroll\"]": {
      "width": "100%",
      "overflow-x": "auto"
    },
    "@media (max-width: 640px)": {
      "[data-slot=\"alert-dialog-content\"], [data-slot=\"dialog-content\"]": {
        "max-width": "100%",
        "width": "100%",
        "margin-top": "auto",
        "border-bottom-left-radius": "0",
        "border-bottom-right-radius": "0"
      }
    },
    "[class*=\"transition\"], [data-slot]": {
      "transition-duration": "var(--motion-duration)",
      "transition-timing-function": "var(--motion-ease)"
    },
    "@media (prefers-reduced-motion: reduce)": {
      "[class*=\"transition\"], [data-slot]": {
        "transition-duration": "1ms"
      }
    }
  },
  "docs": "Green 3 sets Geist Serif for headings, Geist for body and Paper Mono for code. GeistSerifVF.woff2 and PaperMono-Variable.woff2 are self-hosted: copy them from this package's fonts/ into your public/fonts/, or point the @font-face at your own path. A registry item carries CSS, not binaries, so the faces cannot travel in it. Note: this kit sets a text-transform on every element, so installing it recases your whole app. input, textarea, code, pre, abbr and [data-case=\"keep\"] are exempt."
}
