node_modules
dist
.DS_Store

# kit/ is generated but committed on purpose: the registry route serves
# those JSON files straight from the repository, so a URL to them has to
# exist. CI regenerates and fails on a diff, which is what keeps committed
# output from going stale.

# The gate's working files. Baselines are committed; what a run produced and
# what it diffed are not — they are rewritten every time.
film/out
film/diff

# Webfaces cached so the gate is not racing a CDN. Local, and rebuilt on
# first run; CI caches it rather than committing it.
film/fonts-cache

.env
.env.local
