node_modules
dist
.DS_Store

# Generated. `npm run kit` rebuilds it, and the version inside package.json
# is carried across runs, so the folder is output rather than source.
kit

# The gate's working files. Baselines are committed; what a run produced and
# what it diffed are not — they are rewritten every time.
film/out
film/diff

# Webfaces cached so the gate is not racing a CDN. Local, and rebuilt on
# first run; CI caches it rather than committing it.
film/fonts-cache

.env
.env.local
