{
  "name": "design-kit",
  "version": "0.1.0",
  "private": true,
  "description": "A theming kit for Tailwind v4 and shadcn/ui: tokens on separate axes, four products, and an exportable design kit.",
  "license": "MIT",
  "author": "Theo Letts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REPLACE-ME/design-kit.git"
  },
  "homepage": "https://github.com/REPLACE-ME/design-kit#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ci": "tsc --noEmit && vitest run && prettier --check . && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "kit": "node scripts/kit.mjs",
    "release": "npm run kit && cd kit && npm publish --access public",
    "film": "node scripts/film.mjs",
    "film:update": "node scripts/film.mjs --update",
    "film:kits": "node scripts/film.mjs --kits",
    "film:mobile": "node scripts/film.mjs --width 390 --height 844",
    "film:mobile:update": "node scripts/film.mjs --width 390 --height 844 --update",
    "film:kits:update": "node scripts/film.mjs --kits --update",
    "film:motion": "node scripts/film.mjs --motion"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
